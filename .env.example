# Copy to .env and populate every value before running any service.
# All values below are placeholders. No real credential belongs in this file
# or in any file committed to source control (see docs/adr and Section 13.3
# of the build spec: secrets are read from a managed secret store at runtime).

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API (apps/api) ----
API_PORT=3001
API_BASE_URL=http://localhost:3001
DASHBOARD_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
SESSION_COOKIE_NAME=__Host-session
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CSRF_SECRET=replace-with-32-byte-random-value

# ---- Database ----
# DATABASE_URL: the least-privileged application role. Row-level security
# (Section 5.1c) applies only to non-superuser connections, so this must
# never be a superuser.
DATABASE_URL=postgresql://voice_app:local-dev-only@localhost:5432/voice_receptionist
DATABASE_APPLICATION_ROLE=voice_app
# DATABASE_MIGRATOR_URL: used only by `prisma migrate deploy` / `prisma db seed`.
# Needs DDL rights; superuser locally, a dedicated migrator role in staging/production.
DATABASE_MIGRATOR_URL=postgresql://postgres:local-dev-only@localhost:5432/voice_receptionist

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Argon2id password hashing (Module 3, A3.1) ----
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- TOTP (Module 3, A3.4) ----
TOTP_ISSUER=Voice Receptionist

# ---- Voice gateway (apps/voice-gateway) ----
VOICE_GATEWAY_PORT=3002
VOICE_GATEWAY_SERVICE_TOKEN=replace-with-service-token

# ---- Provider selection (Module 6) — set once Module 1's feasibility probe
# clears the halt gate with real corpora; see docs/adr/dialect-feasibility-verdict.md ----
SPEECH_RECOGNITION_PROVIDER=fixture
SPEECH_SYNTHESIS_PROVIDER=fixture
LANGUAGE_MODEL_PROVIDER=fixture
TELEPHONY_PROVIDER=fixture

SPEECH_RECOGNITION_API_KEY=replace-with-key
SPEECH_SYNTHESIS_API_KEY=replace-with-key
LANGUAGE_MODEL_API_KEY=replace-with-key
TELEPHONY_API_KEY=replace-with-key
TELEPHONY_WEBHOOK_SIGNING_SECRET=replace-with-secret

# ---- Dashboard (apps/dashboard) ----
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_RECORDING_ORIGIN=http://localhost:3001

# ---- Observability ----
SENTRY_DSN=

# ---- Storage (recordings) ----
RECORDING_BUCKET=replace-with-bucket-name
RECORDING_SIGNED_URL_TTL_SECONDS=300

# ---- Data residency ----
CLOUD_REGION=me-central-saudi-arabia
