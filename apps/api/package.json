{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "prisma:generate": "prisma generate",
    "retention": "ts-node --compiler-options {\"module\":\"CommonJS\"} src/retention/run-retention.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@prisma/client": "5.22.0",
    "@sentry/node": "8.35.0",
    "@voice-receptionist/logger": "workspace:*",
    "@voice-receptionist/shared": "workspace:*",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.6",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "otplib": "12.0.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/supertest": "6.0.2",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "unplugin-swc": "2.0.0",
    "vitest": "2.1.4"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
