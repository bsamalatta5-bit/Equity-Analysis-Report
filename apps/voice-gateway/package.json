{
  "name": "voice-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "dev": "ts-node --compiler-options {\"module\":\"CommonJS\"} src/main.ts",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@voice-receptionist/logger": "workspace:*",
    "@voice-receptionist/shared": "workspace:*",
    "ioredis": "5.4.1",
    "pino": "9.5.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/ws": "8.5.12",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
