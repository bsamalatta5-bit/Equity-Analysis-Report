    "run-benchmark": "ts-node --compiler-options {\"module\":\"CommonJS\"} src/run-benchmark.ts"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
